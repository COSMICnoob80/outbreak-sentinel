# Copy to .env and fill in your own values. Placeholders only — never commit real keys.

# LLM provider (primary). Get it from ~/.commandcode/auth.json -> apiKey
CMDC_API_KEY=your_cmdc_api_key
# Model served through the CMDC gateway. Optional: falls back to the app default.
LLM_MODEL=z-ai/glm-5.3-flash

# Optional legacy fallback — Groq currently returns 403 on this account
GROQ_API_KEY=

# Settlement (Base Sepolia testnet, chain 84532)
# Set to "live" to submit real testnet transfers; anything else stays in dry-run.
TELEGRAPH_SETTLEMENT_MODE=live
# Testnet-only key. This is a throwaway Base Sepolia wallet — no mainnet funds.
TELEGRAPH_EVM_PRIVATE_KEY=0xyour_testnet_key
